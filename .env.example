# Template only — copy to .env locally and fill with your own development values.
# Never commit .env or real secrets.

# Frontend (Vite exposes VITE_* values to the browser; use public values only)
VITE_APP_NAME=Odoo-Hackathon
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (server-side only; only needed if a FastAPI backend is added)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER_API_KEY=

# Remove variables for services the project does not use. Never put server secrets in VITE_* variables.
